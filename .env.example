# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/dailyday

# Auth (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=REPLACE_WITH_64_HEX_CHARS
NEXTAUTH_URL=http://localhost:3000

# Fitbit OAuth (https://dev.fitbit.com/apps)
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
FITBIT_REDIRECT_URI=http://localhost:3000/api/fitbit/callback

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback
